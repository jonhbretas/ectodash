# Supabase Dashboard -> Project Settings -> Data API -> Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Dashboard -> Project Settings -> API Keys -> anon / publishable key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase Dashboard -> Project Settings -> API Keys -> service_role / secret key.
# SERVER-ONLY: never prefix with NEXT_PUBLIC_ and never import this into
# any module reachable from the browser bundle (see src/lib/supabase/client.ts).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# http://localhost:3000 for local development; the production Vercel URL
# is added in plan 01-04.
# Production value is the deployed Vercel URL (https://ectodash.vercel.app);
# it must also be added to Supabase Dashboard -> Authentication -> URL
# Configuration (Site URL + Additional Redirect URLs) - otherwise magic
# links sent from production redirect to localhost (RESEARCH.md Pitfall 5).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase Dashboard -> Project Settings -> General -> Reference ID
# (used by `supabase link` in plan 01-02).
SUPABASE_PROJECT_REF=your-project-ref

# Verification-only convenience value (plan 01-04) - the deployed production
# Vercel URL, read only by the Task 2 automated verify script via
# `node --env-file=.env.local`. No application code reads this variable;
# the running app uses NEXT_PUBLIC_SITE_URL instead.
ECTODASH_PROD_URL=https://your-project.vercel.app

# Endereco institucional do Coordenador geral (o mesmo semeado na migracao 0002).
# Usado somente pela suite de testes (tests/db/role-rls.test.ts) para verificar o backfill do papel;
# nunca lido pelo codigo da aplicacao. Nao comitar o valor real — apenas em .env.local (git-ignored).
COORDINATOR_EMAIL=

# Resend Dashboard -> API Keys. SERVER-ONLY: read only inside the cron
# Route Handler's (plan 07-02) call to resend.emails.send() directly --
# this is a separate concern from Supabase Auth's own SMTP relay configuration
# (Dashboard -> Authentication -> SMTP Settings), which this variable does
# not touch or replace.
RESEND_API_KEY=

# Any random 16+ character string. SERVER-ONLY: authenticates Vercel
# Cron's invocation of the reminder route (plan 07-02) via the
# auto-injected Authorization: Bearer header; Vercel Production also sets
# this automatically when a project has at least one cron job configured.
CRON_SECRET=

# OpenCode API key — opencode.ai/auth (from the OpenCode Go subscription).
# SERVER-ONLY: read only inside the extractDemandas Server Action (Phase 8)
# to call the DeepSeek V4 Flash model via the OpenCode gateway's
# OpenAI-compatible chat completions endpoint. Never prefix with
# NEXT_PUBLIC_ and never import this into any module reachable from the
# browser bundle. Do not commit a real value here -- this file is committed
# and public.
OPENCODE_API_KEY=

# Tactiq API key — Tactiq (tactiq.io) app -> Settings -> API keys. SERVER-ONLY:
# read only inside the extrair Server Action (meeting-transcript bridge) to
# list recorded meetings and fetch their transcripts. Never prefix with
# NEXT_PUBLIC_ and never import into any module reachable from the browser
# bundle. Do not commit a real value here -- this file is committed and public.
TACTIQ_API_KEY=

# Optional overrides of the AI provider defaults (defaults: the OpenCode
# gateway endpoint + deepseek-v4-flash). Any OpenAI-compatible chat
# completions provider works -- e.g. the DeepSeek API directly
# (https://api.deepseek.com/chat/completions with model deepseek-chat).
# AI_API_URL=
# AI_MODEL=

# Google Cloud Console -> IAM -> Service accounts -> Create service account,
# download its JSON key, then base64-encode the WHOLE file as a single line
# (`[Convert]::ToBase64String([IO.File]::ReadAllBytes("key.json"))`).
# SERVER-ONLY: read only inside the sync-sheets cron route (Phase 9) to
# build the Google Sheets service-account client. Never prefix with
# NEXT_PUBLIC_. Share the institution's cash-flow spreadsheet with the
# service account's e-mail as Viewer (one-time manual step).
GOOGLE_SERVICE_ACCOUNT_JSON=

# The Google Sheets spreadsheet id (the long string in the sheet's share
# URL between /d/ and /edit). Read only inside the sync-sheets cron route.
SPREADSHEET_ID=

# The range to read (tab name + columns), e.g. "Fluxo de caixa!A:E".
# Defaults to "A:E" when unset.
SPREADSHEET_RANGE=

# WooCommerce WCFM (ECTOLAB) — SERVER-ONLY: read only inside the
# sync-woocommerce cron route and api/wp/ routes. Credentials are
# stored in the wp_stores table; these env vars are the fallback.
# Never prefix with NEXT_PUBLIC_.
WP_STORE_URL=https://store.conscienciologia.org.br
WP_VENDOR_USER=jonathan.bretas
WP_VENDOR_APP_PASSWORD=
WP_VENDOR_ID=18
WP_WEBHOOK_SECRET=
