# Supabase Dashboard -> Project Settings -> Data API -> Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Dashboard -> Project Settings -> API Keys -> anon / publishable key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase Dashboard -> Project Settings -> API Keys -> service_role / secret key.
# SERVER-ONLY: never prefix with NEXT_PUBLIC_ and never import this into
# any module reachable from the browser bundle (see src/lib/supabase/client.ts).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# http://localhost:3000 for local development; the production Vercel URL
# is added in plan 01-04.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase Dashboard -> Project Settings -> General -> Reference ID
# (used by `supabase link` in plan 01-02).
SUPABASE_PROJECT_REF=your-project-ref
